# Copy to .env and fill in. .env is gitignored; this file is committed as documentation.

# Postgres (docker-compose)
POSTGRES_USER=goblin
POSTGRES_PASSWORD=goblin
POSTGRES_DB=goblin_exchange
POSTGRES_PORT=5432
DATABASE_URL=postgresql://goblin:goblin@localhost:5432/goblin_exchange

# Redis (docker-compose, BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Commodities ingestion (scheduler + worker). Defaults to true, and then the
# Blizzard credentials below are required: the API refuses to boot without them.
# Set to false to run the API and website on existing data without a Blizzard account.
INGESTION_ENABLED=true

# Blizzard API (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
