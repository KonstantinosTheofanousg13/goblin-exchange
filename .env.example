# Copy to .env and fill in. .env is gitignored; this file is committed as documentation.

# Postgres (docker-compose)
POSTGRES_USER=goblin
POSTGRES_PASSWORD=goblin
POSTGRES_DB=goblin_exchange
POSTGRES_PORT=5432
DATABASE_URL=postgresql://goblin:goblin@localhost:5432/goblin_exchange

# Redis (docker-compose, BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Blizzard API (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
