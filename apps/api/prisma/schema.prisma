// Prisma 7: connection settings live in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The app is CommonJS; bare imports work for both `nest build` and ts-jest.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// One Blizzard commodities snapshot (published about hourly, region-wide).
model Snapshot {
  id           Int      @id @default(autoincrement())
  region       String
  /// Blizzard's Last-Modified header: identifies the snapshot.
  lastModified DateTime @map("last_modified") @db.Timestamptz(3)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  auctionCount Int      @map("auction_count")

  prices ItemPriceHourly[]

  /// Idempotency: the same snapshot can never be ingested twice.
  @@unique([region, lastModified])
  @@map("snapshot")
}

/// A WoW item. Ingestion creates the row with just the id;
/// ItemsModule fills in name/icon/quality from Blizzard's item endpoint later.
model Item {
  /// Blizzard's item id (not generated by us).
  id        Int      @id
  name      String?
  icon      String?
  quality   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices ItemPriceHourly[]

  @@map("item")
}

/// Per-item aggregates for one snapshot: the hourly time series behind the charts.
/// Prices are in copper (1 gold = 10,000 copper) as BigInt: money is never stored as a float,
/// and the gold cap (10M gold = 10^11 copper) doesn't fit in a 32-bit Int.
model ItemPriceHourly {
  snapshotId    Int      @map("snapshot_id")
  itemId        Int      @map("item_id")
  /// Copy of snapshot.last_modified, so time-range queries don't need a join.
  capturedAt    DateTime @map("captured_at") @db.Timestamptz(3)
  minPrice      BigInt   @map("min_price")
  /// Average unit price of the cheapest ~15% of listed quantity.
  marketPrice   BigInt   @map("market_price")
  totalQuantity Int      @map("total_quantity")
  listingCount  Int      @map("listing_count")

  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@id([snapshotId, itemId])
  /// Chart queries: one item's prices over a time range.
  @@index([itemId, capturedAt])
  @@map("item_price_hourly")
}
